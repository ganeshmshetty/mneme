# One model key is required. See README.md for details.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENCODE_API_KEY=
# This build defaults to OpenCode Go.
OPENCODE_PLAN=go
OPENCODE_REASONING_EFFORT=low
MNEME_DEFAULT_MODEL=deepseek-v4.1-flash

# Optional search keys. Search works without these through Firecrawl Keyless.
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
SEARCH_PROVIDER=
